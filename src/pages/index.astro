---
import path from "node:path";

import { loadCourseModel } from "../content-model/load";
import { validateContent } from "../content-model/validate";
import type { Section } from "../content-model/types";

const contentRoot = path.resolve(process.cwd(), "content");
const { model, issues } = await loadCourseModel(contentRoot);
const errors = [...issues, ...validateContent(model)].filter((issue) => issue.severity === "error");

// The build fails on content errors, so this page can assume a valid tree.
if (errors.length > 0) {
  throw new Error(`content has ${errors.length} error(s); run \`bun run validate\``);
}

interface Row {
  depth: number;
  section: Section;
}

function flatten(parentId: string | null, depth: number): Row[] {
  const children = model.sections
    .filter((section) => section.parentId === parentId)
    .sort((a, b) => a.order - b.order);
  return children.flatMap((section) => [{ depth, section }, ...flatten(section.id, depth + 1)]);
}

const rows = flatten(null, 0);
const lessonsOf = (sectionId: string) =>
  model.lessons.filter((lesson) => lesson.sectionId === sectionId).sort((a, b) => a.order - b.order);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI 时代的计算机科学</title>
  </head>
  <body>
    <main>
      <h1>AI 时代的计算机科学</h1>
      <p>
        课程树索引。课时路由与阅读界面尚未实现；本页由构建期加载的内容模型生成，用于验证课程树、术语表与实验夹具的一致性。
      </p>
      <ul>
        {
          rows.map(({ depth, section }) => (
            <li>
              <h2 style={`margin-left: ${depth}rem`}>{section.label}</h2>
              {section.summary && <p style={`margin-left: ${depth}rem`}>{section.summary}</p>}
              <ul>
                {lessonsOf(section.id).map((lesson) => (
                  <li>
                    {lesson.title} <code>{lesson.slug}</code>
                    {lesson.status !== "published" && <em> ({lesson.status})</em>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <footer>
        <p>
          {model.sections.length} 章节 · {model.lessons.length} 课时 · {model.glossary.length} 术语 · {
            model.labs.length
          } 实验
        </p>
      </footer>
    </main>
  </body>
</html>

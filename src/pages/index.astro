---
import { getCourseModel } from "../content-model/instance";
import { buildCourseTree, readingOrder, type CourseTreeNode } from "../content-model/navigation";
import CourseLayout from "../layouts/CourseLayout.astro";

const model = await getCourseModel();
const tree = buildCourseTree(model, { includeUnpublished: import.meta.env.DEV });

/**
 * The top of the tree is one umbrella section naming the whole course, which
 * the heading below already does. What this page lists is its children; a tree
 * without that umbrella lists itself.
 */
const modules = tree.length === 1 && tree[0].lessons.length === 0 ? tree[0].children : tree;

const first = readingOrder(tree)[0];

/** Lessons in a section and in everything it contains. */
function lessonCount(node: CourseTreeNode): number {
  return node.lessons.length + node.children.reduce((total, child) => total + lessonCount(child), 0);
}
---

<CourseLayout
  title="AI 时代的计算机科学"
  description="面向专业自学者的计算机科学课程：内容优先，可在浏览器内运行 Python 与 SQL 实验。"
>
  <article class="prose course-index">
    <h1>AI 时代的计算机科学</h1>
    <p>
      一门面向专业自学者的计算机科学课程。课程假定读者具备一定的技术素养和推理能力，但不假定有正式 CS
      背景或者前置知识。
    </p>
    {first && <p class="start"><a href={`${first.slug}/`}>开始阅读：{first.title}</a></p>}

    <ul class="module-list">
      {
        modules.map((node) => {
          const entry = readingOrder([node])[0];
          const count = lessonCount(node);
          return (
            <li class="module">
              <h2>{entry ? <a href={`${entry.slug}/`}>{node.section.label}</a> : node.section.label}</h2>
              {node.section.summary && <p>{node.section.summary}</p>}
              {count > 0 && <p class="module-meta">{count} 课时</p>}
            </li>
          );
        })
      }
    </ul>
  </article>
</CourseLayout>

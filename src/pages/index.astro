---
import { getCourseModel } from "../content-model/instance";
import { buildCourseTree, readingOrder, type CourseTreeNode } from "../content-model/navigation";
import CourseLayout from "../layouts/CourseLayout.astro";

const model = await getCourseModel();
const tree = buildCourseTree(model, { includeUnpublished: import.meta.env.DEV });
const first = readingOrder(tree)[0];

function flatten(nodes: CourseTreeNode[]): CourseTreeNode[] {
  return nodes.flatMap((node) => [node, ...flatten(node.children)]);
}

const sections = flatten(tree);
---

<CourseLayout
  title="AI 时代的计算机科学"
  description="面向专业自学者的计算机科学课程：内容优先，可在浏览器内运行 Python 与 SQL 实验。"
>
  <article class="prose course-index">
    <h1>AI 时代的计算机科学</h1>
    <p>
      一门面向专业自学者的计算机科学课程。课程假定读者具备一定的技术素养和推理能力，但不假定有正式 CS
      背景或者前置知识。
    </p>
    {first && <p><a href={`${first.slug}/`}>开始阅读：{first.title}</a></p>}

    {
      sections.map((node) => (
        <section class:list={["course-section", `depth-${node.depth}`]}>
          <h2>{node.section.label}</h2>
          {node.section.summary && <p>{node.section.summary}</p>}
          {node.lessons.length > 0 && (
            <ul>
              {node.lessons.map((lesson) => (
                <li>
                  <a href={`${lesson.slug}/`}>{lesson.title}</a>
                  {lesson.estimatedReadingMinutes && (
                    <span class="lesson-meta"> · 约 {lesson.estimatedReadingMinutes} 分钟</span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</CourseLayout>

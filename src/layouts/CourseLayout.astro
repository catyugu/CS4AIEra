---
import CourseTree from "../components/CourseTree.astro";
import PageToc from "../components/PageToc.astro";
import { getCourseModel } from "../content-model/instance";
import {
  buildCourseTree,
  buildToc,
  sectionPathIds,
  topLevelSectionIds,
  type TocEntry,
} from "../content-model/navigation";
import "../styles/global.css";

/**
 * Reading shell: course tree, lesson body, page contents.
 *
 * Everything here is static HTML. The only client script a reading page loads
 * is the one that accompanies a feature the page actually has: the code-cell
 * runtime on lessons with executable cells, term-tip placement on pages with a
 * term reference, and in-page contents tracking on pages with headings
 * (doc/DESIGN.md, 架构原则 and 术语、导航与搜索).
 *
 * Below 60rem the course tree is a `popover` drawer opened from the header;
 * below 78rem the in-page contents column is replaced by the list the lesson
 * body renders under its title. Both are in the markup on every page, and the
 * stylesheet decides which of them a reader gets.
 */
interface Props {
  title: string;
  description?: string;
  /** Lesson id, when a lesson page is being rendered. */
  activeLessonId?: string;
  /** Rendered headings of the lesson body. */
  headings?: TocEntry[];
}

const { title, description, activeLessonId, headings = [] } = Astro.props;

const model = await getCourseModel();
const includeUnpublished = import.meta.env.DEV;
const tree = buildCourseTree(model, { includeUnpublished });

const activeLesson = activeLessonId
  ? model.lessons.find((lesson) => lesson.id === activeLessonId)
  : undefined;
/**
 * Open the current lesson's branch; a page with no lesson opens the top level
 * only, so no page starts with the whole tree expanded.
 */
const openSectionIds = activeLesson
  ? sectionPathIds(model, activeLesson.sectionId)
  : topLevelSectionIds(tree);

const toc = buildToc(headings);
const siteTitle = "CS4AIEra";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? siteTitle : `${title} · ${siteTitle}`}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="site-title" href="/">{siteTitle}</a>
      <nav aria-label="站点">
        <button class="tree-toggle" type="button" popovertarget="course-tree">目录</button>
        <a href="/glossary/">术语表</a>
      </nav>
    </header>
    <div class="shell">
      <nav class="sidebar" id="course-tree" popover="auto" aria-label="课程树">
        <CourseTree nodes={tree} openSectionIds={openSectionIds} activeLessonId={activeLessonId} />
      </nav>
      <main id="main">
        <slot />
      </main>
      {
        toc.length > 0 && (
          <nav class="page-toc" data-toc aria-label="本页目录">
            <h2>本页目录</h2>
            <PageToc entries={toc} />
          </nav>
        )
      }
    </div>
    <footer class="site-footer">
      <p>
        {model.sections.length} 章节 · {model.lessons.length} 课时 · {model.glossary.length} 术语
      </p>
    </footer>
  </body>
</html>
